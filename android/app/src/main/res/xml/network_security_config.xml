<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">apex-ea.com</domain>
        <domain includeSubdomains="true">metaapi.cloud</domain>
        <domain includeSubdomains="true">agiliumtrade.ai</domain>
        <domain includeSubdomains="true">paypal.com</domain>
        <domain includeSubdomains="true">paypalobjects.com</domain>
    </domain-config>
</network-security-config>
